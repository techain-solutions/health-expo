{
  "name": "health-expo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "supabase:env": "node scripts/sync-local-supabase-env.mjs",
    "staff:provision": "node scripts/provision-staff.mjs",
    "staff:provision:test-local": "node scripts/provision-local-test-staff.mjs",
    "staff:test:local": "node scripts/check-local-auth.mjs",
    "floor-plan:test:local": "node scripts/verify-floor-plan-local.mjs",
    "requests:test:local": "node --env-file=.env.local scripts/verify-requests-local.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.12",
    "supabase": "^2.110.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
