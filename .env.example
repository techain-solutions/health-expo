# Supabase project values. Use `npm run supabase:env` for the local stack, then
# replace these with the remote project values in Vercel when access is approved.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only. Used by `npm run staff:provision` and the approved F-014
# Administrator-managed staff-account actions. Do not expose this variable with
# a NEXT_PUBLIC_ prefix; configure it only in the secure server runtime.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Public application origin. Used only to create a safe local fallback when the
# configured external ticket URL is unavailable. Set this to the deployed URL in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional production form notification delivery through Resend. When these
# remain unset, submissions are still persisted and visible in Form requests.
# Configure all three together in the server environment; never expose the key.
RESEND_API_KEY=YOUR_RESEND_API_KEY
FORM_NOTIFICATION_FROM=Health Beauty Expo <forms@YOUR_VERIFIED_DOMAIN>
FORM_NOTIFICATION_TO=YOUR_TEAM_EMAIL
